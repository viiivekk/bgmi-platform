# MySQL 8.0.16+ connection (required)
DATABASE_URL="mysql://root:root@localhost:3306/esports"

# Session/JWT signing secret (required once auth lands). Generate your own: openssl rand -base64 48
AUTH_SECRET=""

# Result approval policy: false = approver must differ from submitter
ALLOW_SELF_APPROVAL=false

# Branding is neutral by default. Use official KRAFTON/BGMI marks ONLY with written authorization.
BRAND_NAME="Esports Platform"
BRAND_LOGO_URL=""

# Planned (not used yet): media storage (S3-compatible), cache, realtime
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# REDIS_URL=""
