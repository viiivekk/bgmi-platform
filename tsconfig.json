{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023"],
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "esModuleInterop": true,
    "types": ["node"], "noEmit": true, "isolatedModules": true
